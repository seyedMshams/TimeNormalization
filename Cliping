def detect_quote_issues(text: str):
    if not text:
        return False, []

    issues = []

    if '"' in text:
        issues.append("straight_quote")

    if text.count("“") != text.count("”"):
        issues.append("unbalanced_smart_double_quote")

    if text.count("‘") != text.count("’"):
        issues.append("unbalanced_smart_single_quote")

    if "'" in text:
        issues.append("apostrophe_or_single_quote")

    return len(issues) > 0, issues


