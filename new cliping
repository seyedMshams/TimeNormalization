DB_NAME = "your_db_name"
COLLECTION_NAME = "medicalSummary"

client = MongoClient(MONGO_URI)
db = client[DB_NAME]
collection = db[COLLECTION_NAME]


def extract_problematic_timeline_events(limit: int = 0) -> pd.DataFrame:
    rows = []

    cursor = collection.find(
        {},
        {
            "_id": 1,
            "disabilityFolderId": 1,
            "langfuseTraceId": 1,
            "chapters": 1
        }
    )

    if limit:
        cursor = cursor.limit(limit)

    for doc in cursor:
        document_id = str(doc.get("_id"))
        disability_folder_id = doc.get("disabilityFolderId")
        langfuse_trace_id = doc.get("langfuseTraceId")

        for chapter in doc.get("chapters", []):
            chapter_id = chapter.get("chapter")
            timeline = chapter.get("structuredTimeline", {})
            events = timeline.get("events", [])

            for event in events:
                short_string = event.get("shortDescription")
                full_string = (
                    event.get("eventTextWithoutCitations")
                    or event.get("fullString")
                )

                analysis = detect_sentence_and_quote_issues(full_string)

                if not analysis["valid"]:
                    rows.append({
                        "document_id": document_id,
                        "disability_folder_id": disability_folder_id,
                        "langfuse_trace_id": langfuse_trace_id,
                        "chapter": chapter_id,
                        "date": event.get("date"),
                        "short_string": short_string,
                        "full_string": full_string,
                        "has_issue": True,
                        "issue_types": analysis["issues"],
                        "has_quote_issue": any("quote" in i for i in analysis["issues"]),
                        "has_sentence_issue": any(
                            i in {
                                "missing_verb",
                                "too_short",
                                "too_long",
                                "invalid_sentence_ending",
                                "starts_with_conjunction"
                            }
                            for i in analysis["issues"]
                        )
                    })

    return pd.DataFrame(rows)


if __name__ == "__main__":
    df = extract_problematic_timeline_events(limit=0)

    print(f"Identified {len(df)} problematic timeline events")

    # Save for audit / reporting
    df.to_csv("timeline_validation_findings.csv", index=False)
    df.to_parquet("timeline_validation_findings.parquet")

